{
    "name": "gsmui/gsmui-pro",
    "description": "The pro version of Gsmui, the official UI component library for Livewire. 200+ premium components with dark mode, CSP support, and comprehensive theming.",
    "keywords": ["gsmui", "laravel", "livewire", "components", "ui", "dark-mode", "csp", "tailwind"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Md Shamim Hossain",
            "email": "shamimstack@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "autoload": {
        "psr-4": {
            "GsmuiPro\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "GsmuiPro\\Tests\\": "tests/",
            "App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GsmuiPro\\GsmuiProServiceProvider"
            ],
            "aliases": {
                "GsmuiPro": "GsmuiPro\\GsmuiPro"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test:smoke": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/run-smoke.php"
        ],
        "manifest": "@php scripts/build-component-manifest.php",
        "ledger": "@php scripts/prd-ledger.php",
        "docs:build": [
            "@manifest",
            "@test:smoke",
            "@ledger"
        ],
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "format": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --port=3000"
        ]
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}
