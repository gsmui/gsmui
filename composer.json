{
    "name": "gsmui/gsmui-pro",
    "description": "The pro version of Gsmui, the official UI component library for Livewire.",
    "keywords": ["gsmui", "laravel", "livewire", "components", "ui"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Md Shamim Hossain",
            "email": "shamimstack@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5|^8.6|^8.7|^8.8|^8.9|^9.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "livewire/livewire": "^3.7.4|^4.0",
        "filament/support": "^3.0|^4.0",
        "laravel/prompts": "^0.1.24|^0.2|^0.3",
        "gsmui/gsmui": "1.0|dev-main"
    },
    "autoload": {
        "psr-4": {
            "GsmuiPro\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "GsmuiPro\\GsmuiProServiceProvider"
            ],
            "aliases": {
                "Gsmui": "GsmuiPro\\GsmuiPro"
            }
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "workbench/app/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --port 3000 --ansi"
        ]
    },
    "require-dev": {
        "livewire/volt": "*",
        "orchestra/testbench": "^10.8|^11.0"
    }
}
